{
	"version": 8,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}"
			}
		},
		{
			"name": "Win64",
			"displayName": "MinGW GCC (Win64)",
			"description": "Build for Windows with MinGW",
			"inherits": "base",
			"generator": "MinGW Makefiles",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "Android",
			"displayName": "Build for Android",
			"description": "Build DEngine for Android (ARM64)",
			"inherits": "base",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
				"ANDROID_PLATFORM": "android-31",
				"ANDROID_ABI": "arm64-v8a"
			}
		}
	]
}